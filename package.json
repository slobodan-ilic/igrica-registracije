{
  "name": "kvizovi",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev:tablice": "npm run dev -w @kviz/tablice",
    "dev:geografija": "npm run dev -w @kviz/geografija",
    "build": "npm run typecheck:api && npm run build -w @kviz/tablice && npm run build -w @kviz/geografija",
    "build:tablice": "npm run build -w @kviz/tablice",
    "build:geografija": "npm run build -w @kviz/geografija",
    "lint": "oxlint && node packages/kviz/check-css.mjs",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.4",
    "d3-contour": "^4.0.2",
    "oxlint": "^1.75.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "puppeteer-core": "^25.6.0",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/og": "^1.0.1",
    "jose": "^6.2.9"
  }
}
