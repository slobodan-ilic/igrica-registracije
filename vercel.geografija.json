{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @kviz/geografija",
  "outputDirectory": "apps/geografija/dist",
  "rewrites": [
    {
      "source": "/r/:topic",
      "destination": "/api/share?t=:topic"
    },
    {
      "source": "/((?!api/|_vercel/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
