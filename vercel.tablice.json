{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @kviz/tablice",
  "outputDirectory": "apps/tablice/dist",
  "rewrites": [
    {
      "source": "/r/:topic",
      "destination": "/api/share?t=:topic"
    },
    {
      "source": "/:route(srbija|hrvatska|makedonija|crnagora|slovenija|jugoslavija|dnevni|napredak)",
      "destination": "/:route.html"
    },
    {
      "source": "/((?!api/|_vercel/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
